#!/usr/bin/env bash
# 同时作为其他三个脚本的公共函数库；被 source 时不执行主程序。
XRAY_DIR=/usr/local/etc/xray
XRAY_CONFIG=$XRAY_DIR/config.json
XRAY_META=$XRAY_DIR/deploy.json
XRAY_BIN=/usr/local/bin/xray

xray_error() { printf '错误：%s\n' "$*" >&2; return 1; }
xray_root() { (( EUID == 0 )) || xray_error '请使用 root 运行此工具。'; }
xray_lock() {
    exec 9>/run/lock/xray-deploy.lock
    flock -n 9 || xray_error '另一个安装或重置操作正在运行，请稍后重试。'
}
xray_ipv4() {
    local ip=$1 a b c d
    [[ $ip =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}$ ]] || return 1
    IFS=. read -r a b c d <<< "$ip"
    a=$((10#$a)); b=$((10#$b)); c=$((10#$c)); d=$((10#$d))
    (( a > 0 && a < 224 && b < 256 && c < 256 && d < 256 )) || return 1
    # 不把内网、共享地址、文档地址或环回地址当作公网地址。
    (( a != 10 && a != 127 && !(a == 100 && b >= 64 && b <= 127) &&
       !(a == 169 && b == 254) && !(a == 172 && b >= 16 && b <= 31) &&
       !(a == 192 && b == 168) && !(a == 192 && b == 0) &&
       !(a == 198 && (b == 18 || b == 19)) &&
       !(a == 198 && b == 51 && c == 100) && !(a == 203 && b == 0 && c == 113) ))
}
xray_validate() { "$XRAY_BIN" run -test -config "$1" >/dev/null 2>&1; }
xray_read() {
    local file=${1:-$XRAY_CONFIG}
    [[ -s $file ]] || { xray_error '未找到有效的 Xray 配置，请先运行安装器。'; return 1; }
    # 明确管理一个 REALITY 入站、一个客户端，避免选错节点或留下旧身份。
    XRAY_INDEX=$(jq -er '[.inbounds | to_entries[] | select(.value.protocol == "vless" and
        .value.streamSettings.security == "reality")] | if length == 1 then .[0].key else error("入站数量") end' "$file" 2>/dev/null) ||
        { xray_error '配置必须包含且仅包含一个 VLESS + REALITY 入站。'; return 1; }
    jq -e --argjson i "$XRAY_INDEX" '.inbounds[$i] |
        (.settings.clients | length == 1) and (.settings.decryption == "none") and
        (.settings.clients[0].flow == "xtls-rprx-vision") and
        (.streamSettings.network == "tcp" or .streamSettings.network == "raw") and
        (.port | type == "number" and . >= 1 and . <= 65535) and
        (.streamSettings.realitySettings.serverNames | length > 0) and
        (.streamSettings.realitySettings.shortIds | length == 1)' "$file" >/dev/null 2>&1 ||
        { xray_error '配置不是本工具支持的单客户端 TCP + Vision 配置，已保留原文件。'; return 1; }
    XRAY_PORT=$(jq -r --argjson i "$XRAY_INDEX" '.inbounds[$i].port' "$file")
}
xray_public_key() {
    local private=$1
    [[ $private =~ ^[A-Za-z0-9_-]{43}$ ]] || return 1
    # PKCS#8 X25519 私钥通过标准输入交给 OpenSSL，不放入子进程命令行。
    {
        printf '\x30\x2e\x02\x01\x00\x30\x05\x06\x03\x2b\x65\x6e\x04\x22\x04\x20'
        printf '%s=' "$private" | tr '_-' '/+' | openssl base64 -d -A
    } | openssl pkey -inform DER -pubout -outform DER 2>/dev/null |
        tail -c 32 | openssl base64 -A | tr '/+' '_-' | tr -d '='
}
xray_identity() {
    local keys
    XRAY_UUID=$("$XRAY_BIN" uuid 2>/dev/null)
    keys=$("$XRAY_BIN" x25519 2>/dev/null)
    XRAY_PRIVATE=$(printf '%s\n' "$keys" | sed -nE 's/^Private(Key| key): *//p')
    XRAY_PUBLIC=$(xray_public_key "$XRAY_PRIVATE")
    XRAY_SID=$(openssl rand -hex 8)
    [[ $XRAY_UUID =~ ^[a-f0-9-]{36}$ && $XRAY_PRIVATE =~ ^[A-Za-z0-9_-]{43}$ &&
       $XRAY_PUBLIC =~ ^[A-Za-z0-9_-]{43}$ && $XRAY_SID =~ ^[a-f0-9]{16}$ ]] ||
       xray_error '生成身份参数失败。'
}
xray_port_free() { [[ -z $(ss -H -ltn "sport = :$1") ]]; }
xray_health() {
    local attempt pid listeners
    for ((attempt=0; attempt<15; attempt++)); do
        if systemctl is-active --quiet xray; then
            pid=$(systemctl show xray -p MainPID --value)
            listeners=$(ss -H -ltnp "sport = :$XRAY_PORT")
            if [[ $pid != 0 && $listeners == *"pid=$pid,"* ]]; then return 0; fi
        fi
        sleep 1
    done
    return 1
}
xray_effective() {
    systemctl is-active --quiet xray || { xray_error 'Xray 服务未运行。'; return 1; }
    if [[ ! -f /run/xray-deploy/config.sha256 ]] || ! sha256sum -c /run/xray-deploy/config.sha256 >/dev/null 2>&1; then
        xray_error '配置尚未由本工具的服务加载，或配置已在启动后变化；请运行安装器或重启 Xray 后重试。'; return 1
    fi
}
xray_url() {
    local address=${1:-} uuid sni private public sid flow query
    xray_read || return 1
    xray_validate "$XRAY_CONFIG" || { xray_error '当前配置校验失败。'; return 1; }
    xray_effective || return 1
    if [[ -z $address ]]; then
        address=$(jq -er '.server_ip | select(type == "string")' "$XRAY_META" 2>/dev/null) ||
            { xray_error '缺少服务器地址记录，请运行安装器补全。'; return 1; }
    fi
    xray_ipv4 "$address" || { xray_error '连接地址必须是有效的公网 IPv4。'; return 1; }
    uuid=$(jq -r --argjson i "$XRAY_INDEX" '.inbounds[$i].settings.clients[0].id' "$XRAY_CONFIG")
    flow=$(jq -r --argjson i "$XRAY_INDEX" '.inbounds[$i].settings.clients[0].flow' "$XRAY_CONFIG")
    sni=$(jq -r --argjson i "$XRAY_INDEX" '.inbounds[$i].streamSettings.realitySettings.serverNames[0]' "$XRAY_CONFIG")
    private=$(jq -r --argjson i "$XRAY_INDEX" '.inbounds[$i].streamSettings.realitySettings.privateKey' "$XRAY_CONFIG")
    sid=$(jq -r --argjson i "$XRAY_INDEX" '.inbounds[$i].streamSettings.realitySettings.shortIds[0]' "$XRAY_CONFIG")
    public=$(xray_public_key "$private")
    [[ $public =~ ^[A-Za-z0-9_-]{43}$ ]] || { xray_error '无法从当前私钥推导公钥。'; return 1; }
    query=$(jq -nr --arg flow "$flow" --arg sni "$sni" --arg pbk "$public" --arg sid "$sid" '
        {type:"tcp",security:"reality",flow:$flow,sni:$sni,pbk:$pbk,sid:$sid,fp:"chrome"} |
        to_entries | map((.key | @uri) + "=" + (.value | @uri)) | join("&")')
    printf 'vless://%s@%s:%s?%s#%s\n' "$uuid" "$address" "$XRAY_PORT" "$query" \
        "$(jq -nr --arg name "Xray 节点" '$name | @uri')"
}
xray_link_main() {
    set -Eeuo pipefail
    case ${1:-} in
        -h|--help) printf '用法：/root/xray-link [公网 IPv4]\n生成当前生效配置的 VLESS 分享链接。指定地址只对本次输出有效。\n'; return 0 ;;
    esac
    (( $# <= 1 )) || { xray_error '参数过多，使用 --help 查看帮助。'; return 1; }
    xray_root
    printf '当前 VLESS 分享链接：\n' >&2
    xray_url "${1:-}"
}
if [[ ${BASH_SOURCE[0]} == "$0" ]]; then xray_link_main "$@"; fi
